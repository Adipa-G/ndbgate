    "version": "0.2.0",
    "configurations": [
    {
        "name": "C#: PerformanceTest Debug",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/PerformanceTest/bin/Debug/net10.0/PerformanceTest.dll",
        "args": [],
        "cwd": "${workspaceFolder}/PerformanceTest",
        "console": "internalConsole",
        "stopAtEntry": false
    },
    {
        "name": "C#: PerformanceTest Release",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build-release",
        "program": "${workspaceFolder}/PerformanceTest/bin/Release/net10.0/PerformanceTest.dll",
        "args": [],
        "cwd": "${workspaceFolder}/PerformanceTest",
        "console": "internalConsole",
        "stopAtEntry": false
    },
    {
        "name": "C#: DbGateTestApp Debug",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/DbGateTestApp/bin/Debug/net10.0/DbGateTestApp.dll",
        "args": [],
        "cwd": "${workspaceFolder}/DbGateTestApp",
        "console": "internalConsole",
        "stopAtEntry": false
    },
    {
        "name": "Run Unit Tests",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build-tests",
        "program": "dotnet",
        "args": [
            "test",
            "${workspaceFolder}/DbGateTest/DbGateTest.csproj",
            "--logger", "console;verbosity=normal"
        ],
        "cwd": "${workspaceFolder}",
        "console": "internalConsole",
        "stopAtEntry": false
    }
    ]
}